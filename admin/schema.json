{
  "_doc": "Describes what the local admin can edit. Folders and URLs come from build/lib/content.mjs (collections). \"wiki-*\" stands for one collection per wiki in site.json. Every collection is bilingual; \"shared\" fields are stored once, on the English file. \"default\" fills a new item (\"today\" for dates).",
  "collections": {
    "downloads": {
      "label": "Free downloads",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true
        },
        {
          "name": "summary",
          "type": "textarea",
          "hint": "One or two sentences shown on the card."
        },
        {
          "name": "category",
          "type": "select",
          "source": "resourceCategories",
          "shared": true,
          "required": true
        },
        {
          "name": "type",
          "type": "select",
          "source": "resourceTypes",
          "shared": true
        },
        {
          "name": "format",
          "type": "text",
          "shared": true,
          "hint": "e.g. XLSX, ZIP, Notion, Markdown. Auto-detected from an uploaded file if left empty."
        },
        {
          "name": "version",
          "type": "text",
          "shared": true
        },
        {
          "name": "date",
          "type": "date",
          "shared": true,
          "default": "today"
        },
        {
          "name": "file",
          "type": "file",
          "shared": true,
          "hint": "Upload the file people will download. Or use the link below for something hosted elsewhere (Notion, GitHub, Drive)."
        },
        {
          "name": "url",
          "type": "url",
          "shared": true,
          "hint": "External link, used when there is no uploaded file."
        },
        {
          "name": "tags",
          "type": "tags"
        },
        {
          "name": "draft",
          "type": "bool",
          "shared": true,
          "hint": "Draft items are hidden from the published site.",
          "default": true
        }
      ]
    },
    "guides": {
      "label": "Guides & behind the scenes",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true
        },
        {
          "name": "summary",
          "type": "textarea"
        },
        {
          "name": "date",
          "type": "date",
          "shared": true,
          "default": "today"
        },
        {
          "name": "tags",
          "type": "tags"
        },
        {
          "name": "draft",
          "type": "bool",
          "shared": true
        }
      ]
    },
    "journey": {
      "label": "Journey (blog)",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true
        },
        {
          "name": "summary",
          "type": "textarea"
        },
        {
          "name": "date",
          "type": "date",
          "shared": true,
          "default": "today"
        },
        {
          "name": "tags",
          "type": "tags"
        },
        {
          "name": "draft",
          "type": "bool",
          "shared": true
        }
      ]
    },
    "research": {
      "label": "Research",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true
        },
        {
          "name": "summary",
          "type": "textarea"
        },
        {
          "name": "date",
          "type": "date",
          "shared": true,
          "default": "today"
        },
        {
          "name": "tags",
          "type": "tags"
        },
        {
          "name": "links",
          "type": "links",
          "shared": true,
          "hint": "One per line: Label | https://…"
        },
        {
          "name": "draft",
          "type": "bool",
          "shared": true
        }
      ]
    },
    "career": {
      "label": "Career timeline (About)",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true,
          "hint": "Your role, e.g. Project Control Engineer."
        },
        {
          "name": "org",
          "type": "text",
          "hint": "Employer or client."
        },
        {
          "name": "period",
          "type": "text",
          "hint": "Shown as written, e.g. Aug 2026 – 1 Nov 2026."
        },
        {
          "name": "start",
          "type": "date",
          "shared": true,
          "hint": "Start date. Used only for ordering, newest first."
        },
        {
          "name": "summary",
          "type": "textarea",
          "hint": "One line describing the job."
        }
      ]
    },
    "wiki-*": {
      "fields": "wiki"
    },
    "pages": {
      "label": "Pages (About)",
      "fields": [
        {
          "name": "title",
          "type": "text",
          "required": true
        },
        {
          "name": "summary",
          "type": "textarea"
        }
      ]
    }
  },
  "fieldSets": {
    "wiki": [
      {
        "name": "title",
        "type": "text",
        "hint": "Not needed for the wiki landing page (_index)."
      },
      {
        "name": "summary",
        "type": "textarea"
      },
      {
        "name": "node",
        "type": "select",
        "shared": true,
        "hideOnIndex": true,
        "required": false,
        "default": "post",
        "options": [
          {
            "value": "post",
            "label": "Page: a wiki page (small node on the map)"
          },
          {
            "value": "tag",
            "label": "Topic: a medium node that pages are tagged with"
          }
        ],
        "hint": "What this is on the knowledge map. Knowledge areas are the wikis themselves (their landing page)."
      },
      {
        "name": "tags",
        "type": "tags",
        "suggest": "topics",
        "hint": "Topics this page belongs to. Each one becomes a medium node on the map and bonds to this page. Write them in the same order in every language so they stay one node."
      },
      {
        "name": "aliases",
        "type": "tags",
        "shared": true,
        "hint": "Topics only: other names for this topic, so pages tagged with them connect here."
      },
      {
        "name": "connections",
        "type": "nodes",
        "shared": true,
        "hint": "Bonds to other nodes, chosen by hand. This is the only way pages connect to each other (besides shared topics). Type to search; works from either end."
      },
      {
        "name": "order",
        "type": "number",
        "shared": true,
        "hint": "Position in the side menu. Lower comes first."
      },
      {
        "name": "status",
        "type": "select",
        "shared": true,
        "options": [
          "draft",
          "published"
        ],
        "hint": "'draft' shows a Draft badge.",
        "default": "draft"
      },
      {
        "name": "updated",
        "type": "date",
        "shared": true
      }
    ]
  }
}
