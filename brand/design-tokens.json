{
  "$description": "Design tokens for the Abdelfattah M. site and brand. Source of truth for the site is src/assets/css/main.css.",
  "color": {
    "accent": "#ffcc00",
    "dark": {
      "bg": "#000000",
      "surface": "#0b0b0b",
      "surface2": "#161616",
      "text": "#ffffff",
      "muted": "#a6a6a6",
      "line": "#252525",
      "lineStrong": "#4d4d4d"
    },
    "light": {
      "bg": "#ffffff",
      "surface": "#f7f7f7",
      "surface2": "#ececec",
      "text": "#000000",
      "muted": "#595959",
      "line": "#e1e1e1",
      "lineStrong": "#a8a8a8"
    },
    "ventures": {
      "kyberiaTech": "#ff2f92",
      "kyberiaLabs": "#2d6bff",
      "kyberiaStudios": "#ff7a1a",
      "peridot": "#7eb731"
    }
  },
  "font": {
    "text": {
      "family": "Tajawal",
      "weights": [
        400,
        500,
        700
      ],
      "license": "SIL OFL 1.1",
      "selfHosted": true
    },
    "display": {
      "family": "Satoshi",
      "status": "files not yet added; falls back to Tajawal",
      "license": "ITF Free Font License (fontshare.com)"
    }
  },
  "radius": {
    "circle": "50%",
    "pill": "999px",
    "card": "32px",
    "field": "24px"
  },
  "size": {
    "touchTarget": "44px",
    "circleButton": "44px",
    "circleSmall": "36px",
    "circleLarge": "60px",
    "search": "58px",
    "button": "48px"
  },
  "icon": {
    "grid": 24,
    "stroke": 1.75,
    "cap": "round",
    "join": "round"
  },
  "motion": {
    "fast": "150-180ms",
    "drawer": "300ms",
    "ease": "cubic-bezier(.2,.7,.2,1)",
    "reducedMotion": "respected"
  },
  "logo": {
    "type": "stacked name wordmark (Abdelfattah / Aboulfoutoh) + AM badge",
    "font": "Tajawal Bold now, Satoshi Bold when available",
    "clearSpace": "1 cap-height",
    "minSizePx": {
      "wordmark": 26,
      "badge": 16
    },
    "leading": "1.2x cap height"
  },
  "breakpoints": {
    "nav-collapse": "820px",
    "mobile": "480px"
  }
}